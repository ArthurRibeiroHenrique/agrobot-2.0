{
  "expo": {
    "name": "AgroBot 2.0",
    "slug": "agrobot-2",
    "scheme": "agrobot",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "platforms": [
      "ios",
      "android"
    ],
    "android": {
      "package": "com.agrobot.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "O AgroBot usa o microfone para registrar suas atividades por voz."
        }
      ],
      "expo-status-bar",
      "expo-asset"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "e74877b7-a8b3-4ca9-979d-19da6b0dd5c4"
      }
    },
    "owner": "agrobot-2"
  }
}
