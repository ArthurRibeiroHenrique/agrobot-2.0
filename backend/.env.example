PORT=3333

OPENAI_API_KEY=COLE_SUA_OPENAI_API_KEY_AQUI
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_LLM_MODEL=gpt-4o-mini

SUPABASE_URL=COLE_SUA_URL_DO_PROJETO_SUPABASE
SUPABASE_SERVICE_ROLE_KEY=COLE_SUA_SERVICE_ROLE_KEY
SUPABASE_AUDIO_BUCKET=voice-audio

# String de conexão do PostgreSQL, usada pela fila (pg-boss).
# No painel do Supabase: Connect > Session pooler (porta 5432).
# Não use o Transaction pooler (porta 6543).
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# true: a API também processa a fila. false: rode o worker à parte com "npm run dev:worker".
RUN_WORKER=true

ALLOWED_ORIGINS=http://localhost:3000
