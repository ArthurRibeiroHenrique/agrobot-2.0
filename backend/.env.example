# Porta do backend. No Azure Container Apps, precisa ser igual à porta de entrada (target port).
PORT=3333

# Onde a IA roda: "azure" (Azure OpenAI) ou "openai" (API da OpenAI direto).
AI_PROVIDER=azure

# Azure OpenAI. No portal do Azure: recurso do Azure OpenAI > Keys and Endpoint.
AZURE_OPENAI_ENDPOINT=https://SEU-RECURSO.openai.azure.com
AZURE_OPENAI_API_KEY=COLE_SUA_CHAVE_DO_AZURE_OPENAI
AZURE_OPENAI_API_VERSION=2025-04-01-preview
# Nomes dos deployments criados no Azure AI Foundry (o nome que você deu, não o do modelo).
AZURE_OPENAI_TRANSCRIPTION_DEPLOYMENT=gpt-4o-mini-transcribe
AZURE_OPENAI_LLM_DEPLOYMENT=gpt-5-mini
# Só se a transcrição estiver em outro recurso do Azure (outra região). Em branco, usa os de cima.
AZURE_OPENAI_TRANSCRIPTION_ENDPOINT=
AZURE_OPENAI_TRANSCRIPTION_API_KEY=

# OpenAI direto. Só é usada com AI_PROVIDER=openai.
OPENAI_API_KEY=COLE_SUA_OPENAI_API_KEY_AQUI
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Modelo de raciocínio (família GPT-5). Para comparar com o gpt-5-nano, troque aqui e rode "npm run eval".
OPENAI_LLM_MODEL=gpt-5-mini

SUPABASE_URL=COLE_SUA_URL_DO_PROJETO_SUPABASE
SUPABASE_SERVICE_ROLE_KEY=COLE_SUA_SERVICE_ROLE_KEY
SUPABASE_AUDIO_BUCKET=voice-audio

# String de conexão do PostgreSQL, usada pela fila (pg-boss).
# No painel do Supabase: Connect > Session pooler (porta 5432).
# Não use o Transaction pooler (porta 6543).
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# true: a API também processa a fila. false: rode o worker à parte com "npm run dev:worker".
RUN_WORKER=true

ALLOWED_ORIGINS=http://localhost:3000

# Máximo de chamadas de IA (áudios e perguntas) por usuário a cada hora. Acima disso, a API responde 429.
AI_RATE_LIMIT_PER_HOUR=60

# false (padrão): apaga o áudio depois de processado. true: guarda (ex.: para montar casos reais do eval).
KEEP_AUDIO_AFTER_PROCESSING=false
