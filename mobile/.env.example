# Endereço do backend. No celular, "localhost" é o próprio celular: use o IP do
# computador na rede Wi-Fi (ipconfig), por exemplo http://192.168.0.10:3333/v1
EXPO_PUBLIC_API_URL=http://192.168.0.10:3333/v1

# Painel do Supabase: Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=COLE_A_URL_DO_SUPABASE
EXPO_PUBLIC_SUPABASE_ANON_KEY=COLE_A_CHAVE_ANON
